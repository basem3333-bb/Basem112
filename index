"""
==============================================================
استراتيجية Price Action + مناطق عرض/طلب — نسخة قابلة للبرمجة
==============================================================
تجمع هذه الوحدة القواعد التالية في منطق واحد قابل للاختبار:
  1) فلتر اتجاه: EMA 200
  2) فلتر زخم: RSI (14)
  3) فلتر تقلب: ATR (14) مقابل متوسط 50 شمعة
  4) مناطق عرض/طلب مبنية على "قاعدة + اندفاع"
  5) تأكيد كسر وهمي (Fake Breakout)
  6) فلتر قوة الشموع (جسم، ابتلاع، هامر/شوتنق ستار)
  7) إدارة رأس مال (% مخاطرة لكل صفقة + حد خسائر يومي)
  8) حلقة Backtest بسيطة لقياس الأداء قبل أي تداول حقيقي

تحذير: هذا إطار عمل لتوليد الإشارات فقط. لا يضمن أي نسبة نجاح،
ويجب اختباره (backtest / demo) على بياناتك الفعلية قبل استخدامه
بأي مبلغ حقيقي. فلتر الأخبار أدناه يحتاج تغذية بيانات خارجية
(economic calendar) غير متوفرة هنا.
==============================================================
"""

import pandas as pd
import numpy as np


# ==============================================================
# 1) المؤشرات: EMA / RSI / ATR
# ==============================================================

def add_indicators(df: pd.DataFrame, ema_period=200, rsi_period=14, atr_period=14) -> pd.DataFrame:
    """يتوقع df بأعمدة: open, high, low, close (index = datetime)."""
    df = df.copy()

    df['ema200'] = df['close'].ewm(span=ema_period, adjust=False).mean()

    delta = df['close'].diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)
    avg_gain = gain.ewm(alpha=1 / rsi_period, min_periods=rsi_period).mean()
    avg_loss = loss.ewm(alpha=1 / rsi_period, min_periods=rsi_period).mean()
    rs = avg_gain / avg_loss.replace(0, np.nan)
    df['rsi'] = 100 - (100 / (1 + rs))
    df['rsi'] = df['rsi'].fillna(50)

    high_low = df['high'] - df['low']
    high_close = (df['high'] - df['close'].shift()).abs()
    low_close = (df['low'] - df['close'].shift()).abs()
    tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
    df['atr'] = tr.ewm(alpha=1 / atr_period, min_periods=atr_period).mean()
    df['atr_avg50'] = df['atr'].rolling(50, min_periods=10).mean()

    return df


# ==============================================================
# 2) قوة الشموع وأنماطها
# ==============================================================

def _body(row):
    return abs(row['close'] - row['open'])


def _range(row):
    return row['high'] - row['low']


def is_strong_body(row, min_body_pct=0.6) -> bool:
    r = _range(row)
    return r > 0 and (_body(row) / r) >= min_body_pct


def is_bullish_engulfing(prev, curr, min_ratio=1.3) -> bool:
    prev_bearish = prev['close'] < prev['open']
    curr_bullish = curr['close'] > curr['open']
    engulfs = curr['open'] <= prev['close'] and curr['close'] >= prev['open']
    size_ok = _body(prev) > 0 and _body(curr) >= min_ratio * _body(prev)
    return prev_bearish and curr_bullish and engulfs and size_ok


def is_bearish_engulfing(prev, curr, min_ratio=1.3) -> bool:
    prev_bullish = prev['close'] > prev['open']
    curr_bearish = curr['close'] < curr['open']
    engulfs = curr['open'] >= prev['close'] and curr['close'] <= prev['open']
    size_ok = _body(prev) > 0 and _body(curr) >= min_ratio * _body(prev)
    return prev_bullish and curr_bearish and engulfs and size_ok


def is_hammer(row, wick_ratio=2.0, opp_wick_max=0.3) -> bool:
    body = _body(row)
    if body == 0:
        return False
    lower_wick = min(row['open'], row['close']) - row['low']
    upper_wick = row['high'] - max(row['open'], row['close'])
    return lower_wick >= wick_ratio * body and upper_wick <= opp_wick_max * body


def is_shooting_star(row, wick_ratio=2.0, opp_wick_max=0.3) -> bool:
    body = _body(row)
    if body == 0:
        return False
    upper_wick = row['high'] - max(row['open'], row['close'])
    lower_wick = min(row['open'], row['close']) - row['low']
    return upper_wick >= wick_ratio * body and lower_wick <= opp_wick_max * body


# ==============================================================
# 3) مناطق العرض والطلب (قاعدة + اندفاع)
# ==============================================================

def _find_zones(df, direction, base_max_candles=3, base_body_pct=0.3, impulse_atr_mult=1.5):
    zones = []
    for i in range(base_max_candles + 1, len(df)):
        impulse = df.iloc[i]
        if pd.isna(impulse['atr']):
            continue
        is_impulse = (impulse['close'] > impulse['open']) if direction == 'demand' \
            else (impulse['close'] < impulse['open'])
        if not is_impulse or _body(impulse) < impulse_atr_mult * impulse['atr']:
            continue

        base_end = i - 1
        base_start = base_end
        for j in range(base_end, max(base_end - base_max_candles, 0) - 1, -1):
            c = df.iloc[j]
            r = _range(c)
            if r > 0 and (_body(c) / r) <= base_body_pct:
                base_start = j
            else:
                break
        base_candle = df.iloc[base_end]
        rng = _range(base_candle)
        if rng == 0 or (_body(base_candle) / rng) > base_body_pct:
            continue  # لا توجد قاعدة صالحة

        base_slice = df.iloc[base_start:base_end + 1]
        zones.append({
            'type': direction,
            'end_idx': base_end,
            'zone_low': base_slice['low'].min(),
            'zone_high': base_slice['high'].max(),
        })
    return zones


def find_demand_zones(df, **kwargs):
    return _find_zones(df, 'demand', **kwargs)


def find_supply_zones(df, **kwargs):
    return _find_zones(df, 'supply', **kwargs)


# ==============================================================
# 4) تأكيد الكسر الوهمي
# ==============================================================

def fake_breakout_bullish(candle, zone) -> bool:
    return candle['low'] < zone['zone_low'] and candle['close'] >= zone['zone_low']


def fake_breakout_bearish(candle, zone) -> bool:
    return candle['high'] > zone['zone_high'] and candle['close'] <= zone['zone_high']


# ==============================================================
# 5) فلتر ATR (تقلب كافٍ بدون تطرف)
# ==============================================================

def atr_filter_ok(row, min_pct=0.75, max_pct=2.0) -> bool:
    if pd.isna(row['atr_avg50']) or row['atr_avg50'] == 0:
        return False
    ratio = row['atr'] / row['atr_avg50']
    return min_pct <= ratio <= max_pct


# ==============================================================
# 6) فلتر الأخبار (يحتاج تغذية خارجية - Placeholder)
# ==============================================================

def near_high_impact_news(timestamp, news_times, buffer_minutes=30) -> bool:
    """news_times: قائمة أوقات (datetime) من تقويم اقتصادي خارجي - غير مضمّن هنا."""
    for t in news_times:
        if abs((timestamp - t).total_seconds()) <= buffer_minutes * 60:
            return True
    return False


# ==============================================================
# 7) توليد الإشارة (تجميع كل الفلاتر)
# ==============================================================

def generate_signal(df, i, demand_zones, supply_zones, news_times=None,
                     rsi_bull_min=50, rsi_bear_max=50):
    """يعيد 'CALL' أو 'PUT' أو None بناءً على شمعة الإغلاق i (الدخول = افتتاح الشمعة i+1)."""
    if i < 1 or pd.isna(df.iloc[i]['ema200']):
        return None

    row = df.iloc[i]
    prev = df.iloc[i - 1]

    if news_times and near_high_impact_news(row.name, news_times):
        return None
    if not atr_filter_ok(row):
        return None

    # --- CALL ---
    if row['close'] > row['ema200']:
        zone = next((z for z in demand_zones
                     if z['end_idx'] < i and z['zone_low'] <= row['low'] <= z['zone_high']), None)
        if zone:
            pattern_ok = is_strong_body(row) and (is_bullish_engulfing(prev, row) or is_hammer(row))
            rsi_ok = row['rsi'] > rsi_bull_min or row['rsi'] > prev['rsi']
            if pattern_ok and rsi_ok:
                return 'CALL'

    # --- PUT ---
    if row['close'] < row['ema200']:
        zone = next((z for z in supply_zones
                     if z['end_idx'] < i and z['zone_low'] <= row['high'] <= z['zone_high']), None)
        if zone:
            pattern_ok = is_strong_body(row) and (is_bearish_engulfing(prev, row) or is_shooting_star(row))
            rsi_ok = row['rsi'] < rsi_bear_max or row['rsi'] < prev['rsi']
            if pattern_ok and rsi_ok:
                return 'PUT'

    return None


# ==============================================================
# 8) إدارة رأس المال
# ==============================================================

class RiskManager:
    def __init__(self, capital, risk_pct=1.5, max_daily_losses=3):
        self.capital = capital
        self.risk_pct = risk_pct
        self.max_daily_losses = max_daily_losses
        self.daily_losses = 0
        self._current_day = None

    def position_size(self):
        return self.capital * (self.risk_pct / 100)

    def can_trade(self, timestamp):
        day = timestamp.date()
        if day != self._current_day:
            self._current_day = day
            self.daily_losses = 0
        return self.daily_losses < self.max_daily_losses

    def record_result(self, won, pnl):
        self.capital += pnl
        if not won:
            self.daily_losses += 1


# ==============================================================
# 9) حلقة Backtest بسيطة
# ==============================================================

def backtest(df_raw, capital=1000, payout_pct=85, trade_duration_candles=3):
    """
    payout_pct: نسبة الربح عند فوز الصفقة (كما تعرضها منصات الخيارات الثنائية عادة).
    هذا الرقم وحده يوضح لماذا يحتاج التعادل نسبة نجاح أعلى من 50%.
    """
    df = add_indicators(df_raw)
    demand_zones = find_demand_zones(df)
    supply_zones = find_supply_zones(df)
    risk = RiskManager(capital)

    trades = []
    start = 200  # ننتظر استقرار EMA200
    for i in range(start, len(df) - trade_duration_candles - 1):
        row = df.iloc[i]
        if not risk.can_trade(row.name):
            continue

        signal = generate_signal(df, i, demand_zones, supply_zones)
        if signal is None:
            continue

        entry_price = df.iloc[i + 1]['open']
        exit_price = df.iloc[i + 1 + trade_duration_candles]['close']
        won = (exit_price > entry_price) if signal == 'CALL' else (exit_price < entry_price)

        stake = risk.position_size()
        pnl = stake * (payout_pct / 100) if won else -stake
        risk.record_result(won, pnl)

        trades.append({
            'time': row.name, 'signal': signal, 'entry': entry_price, 'exit': exit_price,
            'won': won, 'pnl': round(pnl, 2), 'capital_after': round(risk.capital, 2)
        })

    result = pd.DataFrame(trades)
    if not result.empty:
        win_rate = result['won'].mean() * 100
        print(f"عدد الصفقات: {len(result)} | نسبة النجاح: {win_rate:.1f}% | "
              f"الرأسمال النهائي: {risk.capital:.2f} (بداية: {capital})")
    return result


# ==============================================================
# مثال تشغيل (بيانات عشوائية للتجربة فقط — ليست بيانات سوق حقيقية)
# ==============================================================

if __name__ == '__main__':
    # ملاحظة: هذه بيانات عشوائية (random walk + دفعات اندفاع صناعية) لإثبات أن
    # الكود يعمل فقط. ليست بيانات سوق حقيقية ولا تصلح لتقييم جدوى الاستراتيجية.
    rng = np.random.default_rng(42)
    n = 3000
    dates = pd.date_range('2026-01-01', periods=n, freq='5min')

    steps = rng.normal(0, 0.04, n)
    impulse_mask = rng.random(n) < 0.05          # ~5% من الشموع تكون "اندفاع" أقوى
    steps = np.where(impulse_mask, steps * rng.uniform(5, 10, n), steps)

    close_ = 100 + np.cumsum(steps)
    open_ = np.concatenate([[100.0], close_[:-1]])   # open = إغلاق الشمعة السابقة (بدون فجوات)
    wick_up = np.abs(rng.normal(0, 0.025, n))
    wick_dn = np.abs(rng.normal(0, 0.025, n))
    high_ = np.maximum(open_, close_) + wick_up
    low_ = np.minimum(open_, close_) - wick_dn

    sample = pd.DataFrame({'open': open_, 'high': high_, 'low': low_, 'close': close_}, index=dates)

    results = backtest(sample, capital=1000, payout_pct=85, trade_duration_candles=3)
    print(results.tail(10) if not results.empty else 'لا صفقات على هذه العينة.')
